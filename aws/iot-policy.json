{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectOnlyAsItsOwnThing",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:us-east-2:<account-id>:client/${iot:Connection.Thing.ThingName}",
      "Condition": {
        "Bool": { "iot:Connection.Thing.IsAttached": "true" }
      }
    },
    {
      "Sid": "PublishAndReceiveOnlyItsOwnShadow",
      "Effect": "Allow",
      "Action": ["iot:Publish", "iot:Receive"],
      "Resource": "arn:aws:iot:us-east-2:<account-id>:topic/$aws/things/${iot:Connection.Thing.ThingName}/shadow/*"
    },
    {
      "Sid": "SubscribeOnlyToItsOwnShadow",
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": "arn:aws:iot:us-east-2:<account-id>:topicfilter/$aws/things/${iot:Connection.Thing.ThingName}/shadow/*"
    }
  ]
}
