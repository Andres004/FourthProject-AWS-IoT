{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StoreReports",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:us-east-2:<account-id>:table/smartloft-data"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-2:<account-id>:log-group:/aws/lambda/smartloft_data_lambda:*"
    }
  ]
}
